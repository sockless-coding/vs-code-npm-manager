{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "sourceMap": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@npm-manager/shared": ["./packages/shared/src/index.ts"],
      "@npm-manager/core": ["./packages/core/src/index.ts"],
      "@npm-manager/webview-ui": ["./packages/webview-ui/src/main.tsx"]
    }
  }
}
