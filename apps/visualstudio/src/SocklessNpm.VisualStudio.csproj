<?xml version="1.0" encoding="utf-8"?>
<!--
  Classic VSSDK extension for Visual Studio 2026.

  This is the *legacy* (non-SDK) project format on purpose: the VSIX packaging
  pipeline lives in Microsoft.VsSDK.targets, which is only imported for projects
  whose <ProjectTypeGuids> include the VSIX project-type GUID
  ({82b43b9b-a64c-4715-b499-d71e9ca2bd60}). A Microsoft.NET.Sdk ("SDK-style")
  project builds the assembly but never produces a .vsix.

  Build with full MSBuild from a "Developer Command Prompt for VS 2026" (or from
  Visual Studio itself) — `dotnet build` cannot build VSIX projects.

  The shared npm engine runs out-of-process as a Node sidecar (Sidecar/sidecar.js),
  so nothing here reimplements the npm logic. Run `npm run build:vs` at the repo
  root first to produce Sidecar/sidecar.js and ..\webview.
-->
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{B1A2C3D4-0000-0000-0000-000000000001}</ProjectGuid>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <OutputType>Library</OutputType>
    <RootNamespace>SocklessNpm.VisualStudio</RootNamespace>
    <AssemblyName>SocklessNpm.VisualStudio</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <!-- 'annotations' keeps the nullable reference syntax meaningful without the
         flow-analysis warnings (CS86xx) that a VSSDK codebase drowns in. -->
    <Nullable>annotations</Nullable>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>

    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension Condition=" '$(Configuration)' == 'Debug' ">true</DeployExtension>

    <StartAction>Program</StartAction>
    <StartProgram Condition=" '$(DevEnvDir)' != '' ">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="SocklessNpmPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <!-- The Node sidecar bundle + the standalone webview, produced by `npm run build:vs`. -->
  <ItemGroup>
    <Content Include="Sidecar\sidecar.js" Condition="Exists('Sidecar\sidecar.js')">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\webview\**\*" Condition="Exists('..\webview')">
      <Link>webview\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Ship WebView2Loader.dll flat next to the managed assembly. The .NET wrapper
      P/Invokes it by simple name; inside devenv.exe the "runtimes\<rid>\native"
      probe does not reliably find it, which shows up as a blank tool window.
      VS 2026 is 64-bit only, so the x64 loader is the right one.
    -->
    <Content Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll"
             Condition="Exists('$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll')">
      <Link>WebView2Loader.dll</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Design" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Security" />
    <Reference Include="System.Xaml" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" GeneratePathProperty="true" />
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition=" '$(VSToolsPath)' != '' " />
</Project>
