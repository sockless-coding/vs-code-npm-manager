{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022"],
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "out-tests",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@npm-manager/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "include": [
    "packages/shared/src/versionRange.ts",
    "packages/shared/src/semverUtil.ts",
    "packages/core/src/npm/npmrc.ts",
    "packages/core/src/projects/jsonEdit.ts",
    "packages/core/src/projects/lockGraph.ts",
    "packages/core/src/projects/advisories.ts",
    "packages/webview-ui/src/packageAge.ts",
    "test/unit/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
