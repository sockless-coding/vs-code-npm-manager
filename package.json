{
  "name": "npm-manager-monorepo",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "author": "Jimmy Everling",
  "repository": {
    "type": "git",
    "url": "https://github.com/sockless-coding/vs-code-npm-manager.git"
  },
  "workspaces": [
    "packages/shared",
    "packages/core",
    "packages/webview-ui",
    "packages/assets",
    "apps/vscode",
    "apps/visualstudio/sidecar"
  ],
  "scripts": {
    "build": "npm run build:vscode && npm run build:vs",
    "build:vscode": "npm run build --workspace apps/vscode",
    "build:vs": "npm run build --workspace @npm-manager/webview-ui -- --production && npm run build --workspace @npm-manager/vs-sidecar -- --production && node scripts/stage-vs-webview.mjs",
    "watch": "npm run watch --workspace apps/vscode",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint packages apps --ext ts,tsx",
    "compile-tests": "tsc -p tsconfig.test.json",
    "test:unit": "npm run compile-tests && cd out-tests && node --test",
    "package:vscode": "npm run package --workspace apps/vscode && npm run vsix --workspace apps/vscode",
    "package:vs": "npm run build:vs && node scripts/build-vsix.mjs Release",
    "smoke:vs-sidecar": "node apps/visualstudio/sidecar/test/smoke.mjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/semver": "^7.5.8",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.23.0",
    "eslint": "^8.57.0",
    "typescript": "^5.5.3"
  }
}
